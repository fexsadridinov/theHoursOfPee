# Browser (safe to commit empty values). Never put the service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. The running origin (window.location.origin) is used when this is empty.
VITE_APP_URL=
VITE_INVITE_EXPIRATION_HOURS=72

# Edge Functions / CI only. Never put these in VITE_* or client code.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
INVITE_FROM_EMAIL=noreply@example.com
APP_URL=
INVITE_EXPIRATION_HOURS=72
